# Example .env (DO NOT commit real secrets)
# Copy this to .env on the server and fill with real values

# Admin authentication (server-side; never expose this in browser code)
ADMIN_PASSKEY=change-this-to-a-long-random-passkey
# Legacy alias still supported for older deployments
# API_TOKEN=change-this-to-a-long-random-passkey

# AWS (for S3 uploads)
AWS_ACCESS_KEY_ID=AKIA...replace
AWS_SECRET_ACCESS_KEY=replace/with/secret
S3_BUCKET=your-s3-bucket-name
S3_REGION=us-east-1
S3_PRESIGN_EXPIRE_HOURS=24

# Database (Postgres RDS)
# Format: postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://dbuser:StrongPassw0rd@your-rds-endpoint:5432/ucs503db

# GHCR / image pulling (if using PAT on server)
GHCR_PAT=ghp_xxx

# Frontend: public API base used when building static site
VITE_API_BASE=https://api.yourdomain.com

# Other
# Add any other environment variables you need locally on the server
